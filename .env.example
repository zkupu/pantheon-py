# OpenAI-compatible gateway URL (REQUIRED — no default)
GATEWAY_URL=

# API key for the configured gateway
INFERENCE_API_KEY=

# Override skills directory (default: .agents/skills)
# SKILLS_DIR=.agents/skills
# AGENTS_DIR=.agents/skills

# Override memory directory (default: .memory)
# MEMORY_DIR=.memory

# Optional tool audit log path
# PANTHEON_AUDIT_LOG_PATH=.audit/tool-calls.jsonl

# Verbose logging (set to 1)
# VERBOSE=1

# Skillgrade — agent API key (used by `make eval`)
# Supports: ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY
ANTHROPIC_API_KEY=

# Shell execution mode (default: allow-list)
# "allow-list" — only permits commands in SHELL_EXEC_ALLOW_LIST (safer)
# "deny-list"  — blocks known-dangerous patterns (legacy, bypassable)
# SHELL_EXEC_MODE=allow-list
# SHELL_EXEC_ALLOW_LIST=git,python,pip,pytest,ruff,ls,cat,grep,find,mkdir,cp,mv
#
# Network tools (curl, wget) are NOT in the default allow-list for security.
# Piping and chaining (|, ;, &&) are blocked in allow-list mode.
# To enable network tools: add curl,wget to your SHELL_EXEC_ALLOW_LIST
# and switch to deny-list mode if you need piping.

# Shell command timeout in seconds (default: 60)
# Increase for slow environments (WSL 2, large test suites)
# SHELL_EXEC_TIMEOUT=120

# Rate limiting (set any limit to enable; set INFERENCE_RATE_LIMIT_HOSTS for auto-enable by hostname)
# INFERENCE_RATE_LIMIT_HOSTS=api.example.com,inference.example.com
# INFERENCE_RATE_LIMIT_PER_SECOND=4
# INFERENCE_RATE_LIMIT_PER_MINUTE=45
# INFERENCE_RATE_LIMIT_PER_HOUR=900
# INFERENCE_RATE_LIMIT_PER_DAY=7000
# INFERENCE_RATE_LIMIT_MAX_REQUESTS_PER_RUN=0
# INFERENCE_RATE_LIMIT_STATE_DIR=~/.cache/inference-rate-limit
# INFERENCE_RATE_LIMIT_DISABLE=false
